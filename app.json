{
  "expo": {
    "name": "OpenPay Send Demo",
    "slug": "openpay-send-example",
    "version": "1.0.0",
    "plugins": [
      [
        "@opentech-com/openpay-send",
        {
          "androidConfigFile": "./openpaysend-android-config.json"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Montserrat-Regular.ttf",
            "./assets/fonts/Montserrat-Bold.ttf"
          ]
        }
      ],
      "react-native-edge-to-edge",
      "expo-status-bar"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.opentech.openpaysend.rn.example"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.opentech.openpaysend.rn.example"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
